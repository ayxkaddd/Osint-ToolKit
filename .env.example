# The setup wizard (/setup) asks for the admin login on first start.
# Every other value can also be set later on the Settings page.
JWT_SECRET=changeme
ROOT_EMAIL=changeme@localhost
ROOT_PASSWORD=$2a$12$M.y/j9t7b56weSkwIBbBEO4rFZTS6D2IP/M/p8i3Cdvbc7FbOSHVW # (changeme) bcrypt hash, e.g. https://bcrypt-generator.com/

# Local tools
GITFIVE_VENV_PATH=path_to_venv_of_gitfive # e.g. /home/user/scripts/GitFive/venv/bin/python or venv/Scripts/python.exe on Windows
GITFIVE_SCRIPT_PATH=path_to_gitfive_script # e.g. /home/user/scripts/GitFive/main.py
GHUNT_VENV_PATH=path_to_venv_of_ghunt # e.g. /home/user/scripts/GHunt/venv (empty: the ghunt command on PATH)
GHUNT_SCRIPT_PATH=path_to_ghunt_script # e.g. /home/user/scripts/GHunt/main.py
HTTPX_PATH=httpx-toolkit # ProjectDiscovery httpx; Kali/Debian name it httpx-toolkit
SUBFINDER_PATH=subfinder

# API keys - the dashboard shows which module needs which
OSINT_INDUSTRIES_API_KEY=your_oi_api_key
FUNSTAT_API_KEY=your_funstat_api_key
WHOIS_XML_API_KEY=your_whois_xml_api_key
SERPAPI_KEY=your_serpapi_key
HACKER_TARGET_API_KEY=your_hacker_target_api_key
SECURITYTRAILS_API_KEY=your_securitytrails_api_key
VIRUSTOTAL_API_KEY=your_virustotal_api_key
IPINFO_API_TOKEN=your_ipinfo_token
ABUSEIPDB_API_KEY=your_abuseipdb_key
SHODAN_API_KEY=your_shodan_key

# Telegram (Funstat media and context, VK history bot) - https://my.telegram.org/apps
TG_API_ID=your_telegram_api_id
TG_API_HASH=your_telegram_api_hash
TG_PHONE_NUMBER=your_phone_number
